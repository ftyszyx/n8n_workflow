{
    "name": "capcut_http_workflow",
    "nodes": [
        {
            "parameters": {},
            "type": "n8n-nodes-base.manualTrigger",
            "typeVersion": 1,
            "position": [
                -720,
                120
            ],
            "id": "manual",
            "name": "When clicking ‘Execute workflow’"
        },
        {
            "parameters": {
                "operation": "captureNetwork",
                "url": "https://v.douyin.com/ZtNn--M8J4M",
                "urlFilter": "/aweme/v1/web/aweme/detail/.*7599985729380322570",
                "browser": "firefox",
                "browserOptions": {
                    "headless": true
                }
            },
            "type": "n8n-nodes-playwright.playwright",
            "typeVersion": 1,
            "position": [
                -480,
                120
            ],
            "id": "playwright",
            "name": "Playwright"
        },
        {
            "parameters": {
                "jsCode": "const urls=[];for(const item of $input.all()){const list=item.json?.records?.[0]?.body?.aweme_detail?.video?.download_addr?.url_list||[];for(const u of list) urls.push(u);}return [{json:{urls}}];"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                -240,
                120
            ],
            "id": "extract",
            "name": "Extract URLs"
        },
        {
            "parameters": {
                "fieldToSplitOut": "urls",
                "options": {
                    "destinationFieldName": "url"
                }
            },
            "type": "n8n-nodes-base.splitOut",
            "typeVersion": 1,
            "position": [
                -20,
                120
            ],
            "id": "splitout",
            "name": "Split Out URLs"
        },
        {
            "parameters": {
                "batchSize": 1,
                "options": {}
            },
            "type": "n8n-nodes-base.splitInBatches",
            "typeVersion": 3,
            "position": [
                220,
                120
            ],
            "id": "loop",
            "name": "Loop Over Items"
        },
        {
            "parameters": {
                "method": "GET",
                "url": "={{$json.url}}",
                "authentication": "none",
                "sendQuery": false,
                "sendHeaders": false,
                "sendBody": false,
                "options": {
                    "response": {
                        "response": {
                            "responseFormat": "file",
                            "outputPropertyName": "data",
                            "fullResponse": false,
                            "neverError": true
                        }
                    }
                }
            },
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                460,
                120
            ],
            "id": "http",
            "name": "HTTP Request",
            "continueOnFail": true
        },
        {
            "parameters": {
                "mode": "expression",
                "output": "={{ $binary.data ? 0 : 1 }}",
                "outputsAmount": 2
            },
            "type": "n8n-nodes-base.switch",
            "typeVersion": 2,
            "position": [
                700,
                120
            ],
            "id": "switch",
            "name": "Has Binary?"
        },
        {
            "parameters": {
                "fileName": "={{'C:\\\\Users\\\\pc\\\\Downloads\\\\douyin_'+$now.toMillis()+'.mp4'}}",
                "dataPropertyName": "data",
                "options": {}
            },
            "type": "n8n-nodes-base.writeBinaryFile",
            "typeVersion": 1,
            "position": [
                940,
                40
            ],
            "id": "write",
            "name": "Write File"
        },
        {
            "parameters": {
                "mode": "raw",
                "jsonOutput": "={\"success\":false,\"reason\":\"all urls failed\"}",
                "includeOtherFields": false,
                "options": {}
            },
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                460,
                260
            ],
            "id": "allfailed",
            "name": "All Failed"
        }
    ],
    "pinData": {},
    "connections": {
        "When clicking ‘Execute workflow’": {
            "main": [
                [
                    {
                        "node": "Playwright",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Playwright": {
            "main": [
                [
                    {
                        "node": "Extract URLs",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Extract URLs": {
            "main": [
                [
                    {
                        "node": "Split Out URLs",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Split Out URLs": {
            "main": [
                [
                    {
                        "node": "Loop Over Items",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Loop Over Items": {
            "main": [
                [
                    {
                        "node": "All Failed",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "HTTP Request",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "HTTP Request": {
            "main": [
                [
                    {
                        "node": "Has Binary?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Has Binary?": {
            "main": [
                [
                    {
                        "node": "Write File",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Loop Over Items",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "active": false,
    "settings": {
        "executionOrder": "v1",
        "availableInMCP": false
    },
    "versionId": "1",
